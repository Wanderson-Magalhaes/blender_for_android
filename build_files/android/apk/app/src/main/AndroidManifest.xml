<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.blender.blender"
    android:versionCode="5030001"
    android:versionName="5.3.0 (S24 Ultra)">

    <!-- Vulkan is used at runtime; not required so it installs on emulators too. -->
    <uses-feature android:name="android.hardware.vulkan.version"
        android:version="0x400000" android:required="false" />
    <!-- Extension repositories, the "Get Extensions" browser and any script that
         fetches a URL all go through Python's urllib. Without this the socket
         call fails with EPERM before a connection is ever attempted. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets Blender tell "offline" apart from "server unreachable" if that
         distinction is ever wanted; harmless and not a runtime permission. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- Blender reads and writes .blend files and their assets by path, so it needs
         access to shared storage rather than the scoped, app-private sandbox. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:label="Blender"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.Blender"
        android:hasCode="true"
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:largeHeap="true">

        <!-- BlenderActivity extends NativeActivity; loads libblender.so and
             bridges soft-keyboard IME text to native.

             screenOrientation="user" follows the device's own rotation setting,
             so the app turns when the user lets it and stays put when they have
             rotation locked. orientation and screenSize are in configChanges,
             which keeps the activity from being recreated on every turn: the
             surface is resized under it instead, and GHOST rebuilds the Vulkan
             swapchain from APP_CMD_WINDOW_RESIZED.

             launchMode="singleTask" is not cosmetic: this is a NativeActivity, and a
             second instance in the same process would run ANativeActivity_onCreate
             again, starting a second android_main and a second Blender init on top of
             the first. It makes a tapped .blend arrive at onNewIntent in the running
             instance instead. -->
        <activity
            android:name="org.blender.blender.BlenderActivity"
            android:label="Blender"
            android:launchMode="singleTask"
            android:screenOrientation="user"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|density|navigation|uiMode"
            android:exported="true">
            <meta-data android:name="android.app.lib_name" android:value="blender" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with Blender" for a .blend tapped in a file manager.

                 The match is made on the file name, not the MIME type: there is no
                 registered type for .blend and an app cannot add one to the system's
                 MimeTypeMap, so a document provider reports application/octet-stream.
                 mimeType="*/*" does not put Blender in every file's "Open with":
                 a data filter has to match every attribute it declares, and
                 pathSuffix still has to hold.

                 pathSuffix rather than the usual pathPattern=".*\\.blend": Android's
                 PatternMatcher implements ".*" without backtracking, so the greedy
                 run swallows the extension and the match fails on any path with a dot
                 in it. pathSuffix arrived in API 29 and minSdk here is 31.

                 host="*" is what makes the suffix count, and it is not optional.
                 IntentFilter.matchData only reaches the path patterns inside the
                 branch it takes when the filter declares an authority; a filter
                 without one never evaluates them and quietly matches every URI of
                 its scheme. Measured on the device: a file:// filter carrying this
                 same pathSuffix offered Blender for a .jpg.

                 Which is also why there is no file:// filter here. A file URI has
                 no authority at all, and matchDataAuthority rejects a null host, so
                 declaring one would make the filter match nothing rather than
                 everything. There is no setting that matches only .blend. Nothing
                 is lost: an app that hands a file:// URI to another app has thrown
                 FileUriExposedException since API 24, so what file managers actually
                 send is content://. resolveUriToPath() still understands the scheme
                 for the case of an explicit component, such as adb. -->
            <intent-filter android:label="Blender">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:host="*"
                    android:mimeType="*/*" android:pathSuffix=".blend" />
            </intent-filter>

            <!-- The same shape again with no mimeType at all, and it is not a
                 duplicate. A filter that declares a type matches only an intent that
                 carries one: IntentFilter.matchData answers NO_MATCH_TYPE both for a
                 null type against a typed filter and for a typed intent against an
                 untyped filter, so the two cases genuinely need two filters.

                 The untyped case is the common one, and the one that made this look
                 broken. A file manager builds the intent type from MimeTypeMap, which
                 has no entry for .blend, so it sends the URI with no type at all.
                 Samsung's My Files does exactly that, and answered "You don't have any
                 apps that can open this type of file" while adb, which was passing a
                 type, resolved to Blender perfectly well. -->
            <intent-filter android:label="Blender">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:host="*"
                    android:pathSuffix=".blend" />
            </intent-filter>

            <!-- MediaStore, where the file name does not survive at all.
                 A MediaStore URI names a row by number: the file the two filters
                 above match as
                 ".../document/primary:Download/Astronaut/Astronaut_v003.blend"
                 arrives here as "content://media/external/file/1000109705". There is
                 no extension in it, so no suffix can be matched, and a filter that
                 declares a path never matches at all.

                 This is not a corner: it is what Samsung's My Files sends, which is
                 why tapping a .blend there answered "You don't have any apps that can
                 open this type of file" while every check against a document provider
                 URI resolved to Blender. Measured with query-activities: that URI with
                 an empty type resolved to no activities whatsoever.

                 mimeType="*/*" is the only type that can be declared, because the type
                 My Files sends is the empty string. findMimeType() answers an empty
                 type through its "matches every type" branch, which only a wildcard
                 filter has. An empty type cannot be declared in a manifest.

                 So the file name cannot narrow this and the type cannot either. What
                 narrows it is the collection: pathPrefix keeps it to the non-media
                 tables, so an image, a video or a piece of music never offers Blender.
                 A non-media file of another kind will, which is the price of being
                 reachable from a file manager at all. Both volume spellings are
                 declared: "external" is what this device uses, "external_primary" is
                 what the platform documents. -->
            <intent-filter android:label="Blender">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:host="media"
                    android:mimeType="*/*" android:pathPrefix="/external/file" />
                <data android:scheme="content" android:host="media"
                    android:mimeType="*/*" android:pathPrefix="/external/downloads" />
                <data android:scheme="content" android:host="media"
                    android:mimeType="*/*" android:pathPrefix="/external_primary/file" />
                <data android:scheme="content" android:host="media"
                    android:mimeType="*/*" android:pathPrefix="/external_primary/downloads" />
            </intent-filter>
        </activity>
    </application>
</manifest>
